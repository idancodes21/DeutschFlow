generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SectionType {
  EXPLAINER
  PATTERN_DRILLS
  GUIDED_SENTENCE
  RECALL
  MIXED_REVIEW
  LISTENING
}

enum ActivityType {
  INFO
  MULTIPLE_CHOICE
  FILL_BLANK
  CONJUGATION
  SENTENCE_BUILDER
  MATCH
  WORD_ORDER
  LISTENING_CHOICE
}

model User {
  id      String @id @default(cuid())
  clerkId String @unique
  email   String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          Profile?
  learningProgress LearningProgress?

  lessonProgress     LessonProgress[]
  vocabularyProgress VocabularyProgress[]
  grammarProgress    GrammarProgress[]
  practiceHistory    PracticeHistory[]

  unitProgress     UnitProgress[]
  sectionProgress  SectionProgress[]
  activityProgress ActivityProgress[]
  activityAttempts ActivityAttempt[]
}

model Profile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  username  String? @unique
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningProgress {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level  Int @default(1)
  xp     Int @default(0)
  streak Int @default(0)

  lessonsCompleted Int @default(0)

  unitsCompleted Int @default(0)

  wordsLearned     Int @default(0)
  grammarCompleted Int @default(0)

  lastActivityAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id String @id @default(cuid())

  title       String
  description String?
  level       Int
  order       Int

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress LessonProgress[]

  @@index([level])
  @@index([isPublished])
}

model LessonProgress {
  id String @id @default(cuid())

  userId   String
  lessonId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completed Boolean @default(false)
  progress  Int     @default(0)
  xpEarned  Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model LearningPath {
  id String @id @default(cuid())

  slug        String  @unique
  name        String
  description String?

  order       Int
  isPublished Boolean @default(false)

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model Unit {
  id String @id @default(cuid())

  pathId String
  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  title       String
  description String?

  order Int

  cefrLevel CefrLevel?

  isPublished Boolean @default(false)

  sections UnitSection[]

  progress UnitProgress[]

  vocabularyLinks UnitVocabulary[]
  grammarLinks    UnitGrammar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pathId, order])
  @@index([pathId])
  @@index([cefrLevel])
  @@index([isPublished])
}

model UnitSection {
  id String @id @default(cuid())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type        SectionType
  title       String
  description String?

  order Int

  activities Activity[]
  progress   SectionProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, order])
  @@index([unitId])
}

model Activity {
  id String @id @default(cuid())

  sectionId String
  section   UnitSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  type  ActivityType
  order Int

  title       String?
  prompt      String?
  explanation String?

  content  Json
  solution Json?

  audioUrl String?
  imageUrl String?

  xpReward Int @default(5)

  isPublished Boolean @default(false)

  progress ActivityProgress[]
  attempts ActivityAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, order])
  @@index([sectionId])
  @@index([type])
  @@index([isPublished])
}

model UnitProgress {
  id String @id @default(cuid())

  userId String
  unitId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  progress     Int @default(0)
  masteryScore Int @default(0)

  completed Boolean @default(false)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
}

model SectionProgress {
  id String @id @default(cuid())

  userId    String
  sectionId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  section UnitSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  progress     Int @default(0)
  masteryScore Int @default(0)

  completed Boolean @default(false)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model ActivityProgress {
  id String @id @default(cuid())

  userId     String
  activityId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  attempts     Int @default(0)
  correctCount Int @default(0)
  wrongCount   Int @default(0)

  bestScore    Int @default(0)
  masteryScore Int @default(0)

  completed Boolean @default(false)

  lastAttemptAt DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
}

model ActivityAttempt {
  id String @id @default(cuid())

  userId     String
  activityId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  response Json?

  isCorrect Boolean
  score     Int     @default(0)

  durationMs Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([activityId])
  @@index([userId, activityId, createdAt])
}

model Vocabulary {
  id String @id @default(cuid())

  german  String
  english String
  article String?
  plural  String?
  example String?

  level    Int
  category String?

  // New curriculum relationship
  unitLinks UnitVocabulary[]

  progress VocabularyProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([category])
}

model UnitVocabulary {
  unitId       String
  vocabularyId String

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  order  Int
  isCore Boolean @default(true)

  @@id([unitId, vocabularyId])
  @@index([vocabularyId])
}

model VocabularyProgress {
  id String @id @default(cuid())

  userId       String
  vocabularyId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  masteryLevel Int @default(0)
  correctCount Int @default(0)
  wrongCount   Int @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@index([nextReviewAt])
}

model Grammar {
  id String @id @default(cuid())

  title       String
  explanation String
  example     String?

  level    Int
  category String?

  // New curriculum relationship
  unitLinks UnitGrammar[]

  progress GrammarProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([category])
}

model UnitGrammar {
  unitId    String
  grammarId String

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  order  Int
  isCore Boolean @default(true)

  @@id([unitId, grammarId])
  @@index([grammarId])
}

model GrammarProgress {
  id String @id @default(cuid())

  userId    String
  grammarId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  masteryLevel Int @default(0)
  correctCount Int @default(0)
  wrongCount   Int @default(0)

  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, grammarId])
  @@index([userId])
}

model PracticeHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  score Int
  total Int

  xpEarned Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
